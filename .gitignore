# Build output. `v .` and `v run` name the binary after the directory, and the
# spikes each build a `main`.
main
vedrock
*.exe
*.exe~
*.so
*.dylib
*.dll
bin/

# V's own leftovers: the C build directory it writes beside the program, and
# the documentation `v doc` generates.
.*.v3cc.*/
*.tmp.c
_docs/

# Modules installed with `v install --local`.
modules/

# Editor and system metadata
.DS_Store
.idea/
.vscode/
*.iml

# Local environment
.env
